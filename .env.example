# ============================================
# BruceLeads - Environment Configuration
# ============================================
# Copy this file to .env and fill in your values.
# These are FALLBACK values — the Setup Wizard and
# Settings page store credentials in data/settings.json
# which takes priority over these.
# ============================================

# --- Google Gemini AI ---
# Get your key at: https://aistudio.google.com/apikey
GEMINI_API_KEY=

# --- Gmail SMTP (Fallback email sending) ---
# Only needed if NOT using Gmail OAuth
# Generate an App Password at: https://myaccount.google.com/apppasswords
GMAIL_ADDRESS=
GMAIL_APP_PASSWORD=

# --- Gmail OAuth (Optional - for draft creation) ---
# Download credentials from Google Cloud Console
# and save to credentials/gmail_credentials.json
# Or upload via the Setup Wizard / Settings page.

# --- Performance ---
# MAX_CONCURRENT_BROWSERS=3    # 1-10, parallel browser tabs for enrichment
# SCRAPING_DELAY=2.0           # Seconds between requests
# GEMINI_TEMPERATURE=0.7       # AI creativity (0.0-2.0)
# MAX_EMAIL_WORDS=150          # Max words per generated email
